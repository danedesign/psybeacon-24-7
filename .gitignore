/windows-host/target/
/mac-client/.build/
.DS_Store

# Generated by windows-host's --stream-test/--network-test/manual verification
# runs (capture snapshots, encoded output, raw frame dumps) — regenerate
# locally with those commands rather than committing multi-MB binaries.
/windows-host/*.bmp
/windows-host/*.png
/windows-host/*.h264
/windows-host/*.mp4
/windows-host/*.ts
/windows-host/*.bgra

# Same idea, mac-client side — test clips generated for AppDelegate's
# playTestFile harness.
/mac-client/*.h264
/mac-client/*.mp4
/mac-client/*.ts
